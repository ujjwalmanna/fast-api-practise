# ---------------------------------------------------------------------------
# Copy to .env and edit.  .env is gitignored - never commit real secrets.
#   cp .env.example .env
# Every variable is prefixed APP_ and maps to a field in core/config.py.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
APP_ENV=local                      # local | dev | staging | production
APP_DEBUG=true
APP_PROJECT_NAME=API Framework
APP_API_V1_PREFIX=/api/v1

# --- Logging --------------------------------------------------------------
APP_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
APP_LOG_JSON=false                 # true in deployed environments, false locally
APP_LOG_REQUEST_BODY=false         # never enable in production - may log PII

# --- Database -------------------------------------------------------------
# Async driver required. SQLite is the default so the project runs with no
# external services. Swap in postgresql+asyncpg://user:pass@host:5432/db
APP_DATABASE_URL=sqlite+aiosqlite:///./api_framework.db
APP_DB_ECHO=false

# --- Security -------------------------------------------------------------
# MUST be overridden outside local. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-in-every-environment-except-local
APP_ACCESS_TOKEN_TTL_MINUTES=15
APP_REFRESH_TOKEN_TTL_DAYS=14
APP_JWT_ALGORITHM=HS256
APP_JWT_ISSUER=api-framework
APP_JWT_AUDIENCE=api-framework

# --- Auth mode ------------------------------------------------------------
# local    -> this service issues and verifies its own HS256 tokens
# external -> tokens are issued by an external IdP and verified via JWKS
#             (this service never sees a password; /auth/login is disabled)
APP_AUTH_MODE=local

# Required only when APP_AUTH_MODE=external
APP_OIDC_JWKS_URL=
APP_OIDC_ISSUER=
APP_OIDC_AUDIENCE=
# Claim that carries the role list, e.g. "roles" or "realm_access.roles"
APP_OIDC_ROLES_CLAIM=roles

# --- CORS -----------------------------------------------------------------
# JSON array. Do NOT use ["*"] together with credentialed requests.
APP_CORS_ORIGINS=["http://localhost:3000"]

# --- Bootstrap admin ------------------------------------------------------
# Created on startup only when it does not already exist and env != production.
APP_FIRST_ADMIN_EMAIL=admin@example.com
APP_FIRST_ADMIN_PASSWORD=ChangeMe123!
